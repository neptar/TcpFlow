<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TcpFlow.Example</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- `dotnet publish -c Release` produces a native executable; this also turns on AOT/trim analyzers at build time. -->
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TcpFlow\TcpFlow.csproj" />
        <!-- Consumers of the NuGet package get the generator automatically; with a project reference it's added explicitly. -->
        <ProjectReference Include="..\TcpFlow.Generator\TcpFlow.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
