<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TcpFlow</RootNamespace>
        <Version>1.0.3</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Description>TcpFlow is a TCP communication library with source generation support</Description>
        <Authors>Rob Walker</Authors>
        <PackageId>TcpFlow</PackageId>
    </PropertyGroup>

    <ItemGroup>
<!--        <ProjectReference Include="..\EasyTcp.Generator\EasyTcp.Generator.csproj"-->
<!--                          OutputItemType="Analyzer"-->
<!--                          ReferenceOutputAssembly="false"/>-->
        <ProjectReference Include="..\TcpFlow.Generator\TcpFlow.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"/>
                <None Include="$(OutputPath)TcpFlow.Generator.dll"
                      Pack="true"
                      PackagePath="analyzers/dotnet/cs"
                      Visible="false" />
    </ItemGroup>
 

</Project>
